<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Nível de Log Geral -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- Silenciar avisos excessivos de conexões WebSocket do JDA -->
    <logger name="net.dv8tion.discord4j" level="WARN" />
</configuration>